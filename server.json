{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.polfananas/catalejo",
  "title": "catalejo",
  "description": "Filings from Spain's securities regulator (CNMV): price-sensitive and regulatory announcements.",
  "repository": {
    "url": "https://github.com/polfananas/catalejo",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "catalejo",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--with", "value": "mcp>=1.20,<2" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
